{
  "name": "@speed-collaboration/core",
  "version": "0.1.0",
  "description": "Framework-agnostic real-time collaboration session manager powered by Yjs & Hocuspocus",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@hocuspocus/provider": "^2.0.0",
    "yjs": "^13.0.0"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^2.15.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "yjs": "^13.6.23"
  },
  "publishConfig": {
    "access": "public"
  }
}
