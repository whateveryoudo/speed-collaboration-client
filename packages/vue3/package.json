{
  "name": "@speed-collaboration/vue3",
  "version": "0.1.0",
  "description": "Vue 3 composition API hooks for real-time collaboration powered by @speed-collaboration/core",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && vue-tsc -p tsconfig.build.json",
    "dev": "vite build --watch",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@speed-collaboration/core": "workspace:*"
  },
  "peerDependencies": {
    "@hocuspocus/provider": "^2.0.0",
    "vue": "^3.3.0",
    "yjs": "^13.0.0"
  },
  "devDependencies": {
    "@hocuspocus/provider": "^2.15.0",
    "@vitejs/plugin-vue": "^5.1.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vue": "^3.5.0",
    "vue-tsc": "^2.1.0",
    "yjs": "^13.6.23"
  },
  "publishConfig": {
    "access": "public"
  }
}

